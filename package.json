{
  "name": "ostseebit-tools",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.8.1",
  "description": "OstseeBit Tools – praktische Werkzeuge für Entwicklung, Administration, Netzwerk und IT.",
  "author": "OstseeBit (https://github.com/OstseeBit)",
  "license": "GNU GPLv3",
  "repository": {
    "type": "git",
    "url": "https://github.com/OstseeBit/ostseebit-tools"
  },
  "keywords": [
    "productivity",
    "converter",
    "website",
    "vuejs",
    "tools",
    "frontend",
    "tool",
    "developer-tools",
    "developer-productivity"
  ],
  "scripts": {
    "dev": "vite",
    "build": "corepack pnpm typecheck && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview --port 5050",
    "test": "npm run test:unit",
    "test:unit": "vitest run --environment jsdom",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false && tsc --noEmit -p tsconfig.vite-config.json --composite false",
    "lint": "eslint src",
    "script:create:tool": "node scripts/create-tool.mjs",
    "script:create:ui": "hygen generator ui-component",
    "release": "node ./scripts/release.mjs",
    "test:unit:watch": "vitest --environment jsdom",
    "check": "corepack pnpm lint && corepack pnpm test:unit && corepack pnpm build",
    "check:all": "corepack pnpm check && corepack pnpm test:e2e:dev --project chromium && corepack pnpm test:e2e && corepack pnpm test:pwa",
    "test:pwa": "playwright test --config playwright.pwa.config.ts"
  },
